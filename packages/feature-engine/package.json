{
  "name": "@ics/feature-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "python -m pytest tests/ -v",
    "test:coverage": "python -m pytest tests/ -v --cov=src --cov-report=term-missing",
    "lint": "ruff check src/ tests/",
    "lint:fix": "ruff check --fix src/ tests/",
    "format": "ruff format src/ tests/",
    "typecheck": "mypy src/",
    "start": "python -m src.main"
  }
}
