{
  "name": "ics-anomaly-detection",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "//": "=== Code Quality (JS/TS) ===",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "yarn workspaces foreach -Apt run typecheck",
    "//2": "=== Testing ===",
    "test": "yarn workspaces foreach -Apt run test",
    "test:js": "yarn workspaces foreach -Apt --include '@ics/dashboard' --include '@ics-anomaly-detection/docs' run test",
    "//3": "=== Building ===",
    "build": "yarn workspaces foreach -Apt --include '@ics/dashboard' --include '@ics-anomaly-detection/docs' run build",
    "build:docs": "yarn workspace @ics-anomaly-detection/docs build",
    "build:dashboard": "yarn workspace @ics/dashboard build",
    "//4": "=== Development ===",
    "dev:docs": "yarn workspace @ics-anomaly-detection/docs start",
    "dev:dashboard": "yarn workspace @ics/dashboard dev",
    "//5": "=== CI Pipeline ===",
    "ci:lint": "yarn lint && yarn format",
    "ci:typecheck": "yarn typecheck",
    "ci:test": "yarn test:js",
    "ci:build": "yarn build",
    "ci": "yarn ci:lint && yarn ci:typecheck && yarn ci:test && yarn ci:build"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
